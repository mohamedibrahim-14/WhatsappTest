<odoo>

<record id="view_event_form_inherit" model="ir.ui.view">
    <field name="name">event.event.form.inherit.registration.mode</field>
    <field name="model">event.event</field>
    <field name="inherit_id" ref="event.view_event_form"/>
    <field name="arch" type="xml">
        <xpath expr="//group/group/field[@name='tag_ids']" position="after">
            <field name="registration_mode"/>
        </xpath>
    </field>
</record>
</odoo>