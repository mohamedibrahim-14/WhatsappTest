<odoo>
    <data noupdate="0">

        <!-- Asset Viewer: Read-only -->
        <record id="group_custom_asset_viewer" model="res.groups">
            <field name="name">Asset Viewer</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_custom_asset_SCM" model="res.groups">
            <field name="name">SCM Group</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_custom_asset_branch_manager" model="res.groups">
            <field name="name">Branch Manager</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>


        <record id="group_project_manager" model="res.groups">
            <field name="name">Project Manager</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_maintenance_user" model="res.groups">
            <field name="name">Maintenance User</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_maintenance_manager" model="res.groups">
            <field name="name">Maintenance Manager</field>
            <field name="category_id" ref="base.module_category_inventory"/>
           <field name="implied_ids" eval="[(4, ref('IH_30north_Inventory_assets.group_maintenance_user'))]"/>
        </record>

        <record id="group_warehouse_manager" model="res.groups">
            <field name="name">Warehouse Manager</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <!-- three groups for btns in requests-->
        <record id="group_approved" model="res.groups">
            <field name="name">Asset Approval Managers</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_validate" model="res.groups">
            <field name="name">Asset Validation Team</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <!-- Handles the purchasing workflow for quantities that are not in stock -->
        <record id="group_purchasing" model="res.groups">
            <field name="name">Purchasing Asset</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <!-- Asset Manager: Full access -->
        <record id="group_confirm_availability" model="res.groups">
            <field name="name">Asset Confirmation</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

