<odoo>
  <data noupdate="1">
    <record id="seq_asset_request" model="ir.sequence">
      <field name="name">Asset Request</field>
      <field name="code">asset.request</field>
      <field name="prefix">Req</field>
      <field name="padding">4</field>
      <field name="number_next">1</field>
    </record>

     <record id="seq_asset_maintenance_request" model="ir.sequence">
        <field name="name">Maintenance Request</field>
        <field name="code">asset.maintenance.request</field>
        <field name="prefix">MRQ</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

        <record id="seq_custom_inventory_picking" model="ir.sequence">
        <field name="name">Custom Inventory Picking</field>
        <field name="code">custom.inventory.picking</field>
        <field name="prefix">OPR/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
    </record>

        <record id="seq_custom_inventory_product_serial" model="ir.sequence">
        <field name="name">Custom Inventory Product Serial</field>
        <field name="code">custom.inventory.product.serial</field>
        <field name="prefix">AUTO-SER-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

  </data>
</odoo>