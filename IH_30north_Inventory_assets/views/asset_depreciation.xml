<odoo>
<record id="view_asset_depreciation_tree" model="ir.ui.view">
    <field name="name">asset.depreciation.tree</field>
    <field name="model">asset.depreciation</field>
    <field name="arch" type="xml">
        <tree string="Asset Depreciations" create="false">
            <field name="asset_id"/>
            <field name="location_id"/>
                    <field name="analytic_account_id"/>
            <field name="entry_date"/>
            <field name="exit_date"/>
            <field name="months_in_location"/>
            <field name="depreciation_value"/>
        </tree>
    </field>
</record>

<!-- Form View -->
<record id="view_asset_depreciation_form" model="ir.ui.view">
    <field name="name">asset.depreciation.form</field>
    <field name="model">asset.depreciation</field>
    <field name="arch" type="xml">
        <form string="Asset Depreciation" create="false">
            <sheet>
                <group>
                    <field name="asset_id"/>
                    <field name="location_id"/>
                    <field name="analytic_account_id"/>
                </group>
                <group>
                    <field name="entry_date"/>
                    <field name="exit_date"/>
                </group>
                <group>
                    <field name="months_in_location" readonly="1"/>
                    <field name="depreciation_value" readonly="1"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
    </odoo>
