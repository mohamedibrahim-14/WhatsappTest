<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_qr_code_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="product">
                        <table style="width: 100%; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 15px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 230px; padding: 15px; text-align: center; border-right: 1px solid #eee; vertical-align: middle;">
                                    <t t-if="product.qr_code and product.qr_url">
                                        <t t-set="qr_src" t-value="'data:image/png;base64,%s' % (product.qr_code if isinstance(product.qr_code, str) else product.qr_code.decode('utf-8'))"/>
                                        <img t-att-src="qr_src" style="width: 200px; height: 200px; border: 2px solid #333;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="width: 200px; height: 200px; border: 2px dashed #999; background-color: #f9f9f9; margin: 0 auto;">
                                            <p style="color: #999; font-size: 12px; padding-top: 80px; text-align: center;">QR Not Available</p>
                                        </div>
                                    </t>
                                </td>

                                <td style="padding: 15px; vertical-align: top;">
                                    <h5 style="margin: 0 0 10px 0; font-size: 18px; font-weight: bold; color: #333; border-bottom: 2px solid #333; padding-bottom: 6px;">
                                        <t t-esc="product.name"/>
                                    </h5>
                                    <table style="width: 100%; font-size: 15px; border-collapse: collapse;">
                                        <tr>
                                            <th style="text-align: left; padding: 6px 10px; background-color: #f5f5f5; width: 30%; border: 1px solid #eee;">Category</th>
                                            <td style="padding: 6px 10px; border: 1px solid #eee;"><t t-esc="product.category_id.name or 'N/A'"/></td>
                                        </tr>
                                        <tr>
                                            <th style="text-align: left; padding: 6px 10px; background-color: #f5f5f5; border: 1px solid #eee;">Reference</th>
                                            <td style="padding: 6px 10px; border: 1px solid #eee;"><t t-esc="product.default_code or 'N/A'"/></td>
                                        </tr>
                                        <tr>
                                            <th style="text-align: left; padding: 6px 10px; background-color: #f5f5f5; border: 1px solid #eee;">Serial No.</th>
                                            <td style="padding: 6px 10px; border: 1px solid #eee;"><t t-esc="product.track_serial or 'N/A'"/></td>
                                        </tr>
                                        <tr>
                                            <th style="text-align: left; padding: 6px 10px; background-color: #f5f5f5; border: 1px solid #eee;">Status</th>
                                            <td style="padding: 6px 10px; border: 1px solid #eee;"><t t-esc="product.asset_status"/></td>
                                        </tr>
                                        <tr t-if="product.qr_url">
                                            <th style="text-align: left; padding: 6px 10px; background-color: #f5f5f5; border: 1px solid #eee;">URL</th>
                                            <td style="padding: 6px 10px; border: 1px solid #eee; font-size: 11px; word-break: break-all; color: #666;"><t t-esc="product.qr_url"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>