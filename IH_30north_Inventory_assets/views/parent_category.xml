<odoo>

<record id="view_parent_category_form" model="ir.ui.view">
    <field name="name">custom.inventory.parent.category.form</field>
    <field name="model">custom.inventory.parent.category</field>
    <field name="arch" type="xml">
        <form string="Product Parent Category">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="view_parent_category_tree" model="ir.ui.view">
    <field name="name">custom.inventory.parent.category.tree</field>
    <field name="model">custom.inventory.parent.category</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="code"/>
        </tree>
    </field>
</record>

    <record id="view_parent_category_search" model="ir.ui.view">
        <field name="name">custom.inventory.parent.category.search</field>
        <field name="model">custom.inventory.parent.category</field>
        <field name="arch" type="xml">
            <search string="Search Parent Categories">

                <!-- Search Fields -->
                <field name="name"/>
                <field name="code"/>

            </search>
        </field>
    </record>




</odoo>