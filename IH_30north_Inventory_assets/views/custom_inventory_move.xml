<odoo>



<record id="view_custom_inventory_move_tree" model="ir.ui.view">
    <field name="name">custom.inventory.move.tree</field>
    <field name="model">custom.inventory.move</field>
    <field name="arch" type="xml">
        <tree string="Movement History" default_order="move_date desc">
            <field name="move_date"/>
            <field name="operation_id"/>
            <field name="product_id"/>
            <field name="track_serial"/>
            <field name="asset_type" optional="show"/>
            <field name="location_id"/>
            <field name="location_dest_id"/>
            <field name="moved_by"/>
            <field name="state"/>
        </tree>
    </field>
</record>

<record id="view_custom_inventory_move" model="ir.ui.view">
    <field name="name">custom.inventory.move.form</field>
    <field name="model">custom.inventory.move</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group>
                        <field name="asset_type"/>
                        <field name="product_id"/>
                        <field name="location_id"/>
                        <field name="location_dest_id"/>

                    </group>
                    <group>
                        <field name="operation_id"/>
                        <field name="state"/>
                        <field name="moved_by"/>
                        <field name="move_date"/>



                    </group>
                </group>

            </sheet>
        </form>
    </field>
</record>


</odoo>